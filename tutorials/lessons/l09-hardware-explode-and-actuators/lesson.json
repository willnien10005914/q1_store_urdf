  "quiz": [
    {
      "id": "q1",
      "question": "瀏覽器爆炸圖展開各個 link 的做法是？",
      "choices": [
        "改 URDF 重匯出 USD",
        "沿「link → 根」方向偏移各 link 的區域座標，再以 timeline 動畫",
        "只旋轉相機",
        "刪除 fixed joint"
      ],
      "answer": 1,
      "explain": "爆炸圖是視覺分解：保留關節拓樸，把每個 link 沿遠離 torso／hip 的方向推開。",
      "question_en": "How does the browser explode view separate links?",
      "choices_en": [
        "Edit URDF and re-export USD",
        "Offset each link along link→root direction in local frames, animated on a timeline",
        "Rotate camera only",
        "Delete fixed joints"
      ],
      "explain_en": "Explode is visual: topology unchanged, links pushed away from torso/hip."
    },
    {
      "id": "q2",
      "question": "ToF／音訊「質量」參數對本課 Isaac Lab 執行的影響？",
      "choices": [
        "只改瀏覽器顏色",
        "提高附加質量比例，例程會上調 ImplicitActuatorCfg stiffness／damping 以維持追蹤",
        "關掉 Newton",
        "改成 PhysX"
      ],
      "answer": 1,
      "explain": "附加感測器質量視為負載；例程用質量比縮放 PD，示範 actuator 參數如何對應硬體配置。",
      "question_en": "Effect of ToF/audio mass parameters on the Isaac Lab run in this lesson?",
      "choices_en": [
        "Browser color only",
        "Increases load ratio; example scales ImplicitActuatorCfg stiffness/damping for tracking",
        "Disables Newton",
        "Forces PhysX"
      ],
      "explain_en": "Sensor mass is extra payload; the example scales PD by mass ratio—hardware config → actuator params."
    },
    {
      "id": "q3",
      "question": "3.0 設定致動器力矩上限應寫？",
      "choices": [
        "effort_limit 一個欄位即可",
        "actuator_effort_limit（模型）與 joint_effort_limit（solver）兩個欄位",
        "只有 torque_max",
        "寫在 URDF 就夠"
      ],
      "answer": 1,
      "explain": "3.0 拆成兩個 limit；explicit 模型輸出會被兩者先後裁切。",
      "question_en": "How should torque limits be set in 3.0?",
      "choices_en": [
        "effort_limit alone is enough",
        "actuator_effort_limit (model) and joint_effort_limit (solver)",
        "torque_max only",
        "URDF alone is enough"
      ],
      "explain_en": "3.0 splits limits; explicit model output clips through both."
    },
    {
      "id": "q4",
      "question": "按「分析／分解」與按「執行」的差別？",
      "choices": [
        "完全一樣",
        "前者在瀏覽器播爆炸動畫／重建外形；後者把同一組硬體＋致動器參數送進 Isaac Lab 例程",
        "前者只下載 webm",
        "後者只改 skin"
      ],
      "answer": 1,
      "explain": "Lab 面板即時預覽不需 GPU；執行才跑 physics＋actuator 追蹤並寫 hardware.json／rollout。",
      "question_en": "Difference between Analyse/Explode and Run?",
      "choices_en": [
        "Identical",
        "Former: browser explode/rebuild; latter: same hardware+actuator params sent to Isaac Lab",
        "Former only downloads webm",
        "Run only changes skin"
      ],
      "explain_en": "Lab panel preview needs no GPU; Run executes physics+actuator tracking and writes hardware.json/rollout."
    },
    {
      "id": "q5",
      "question": "想把感測器裝在 torso 前方，應調哪個參數？",
      "choices": [
        "stiffness",
        "tof_x / tof_y / tof_z（相對於 center_torso_link）",
        "num_envs",
        "fps 即可"
      ],
      "answer": 1,
      "explain": "配件座標系掛在 center_torso_link；XYZ 是相對位移，size／mass 改外形與負載。",
      "question_en": "Which parameters mount a sensor on the front of the torso?",
      "choices_en": [
        "stiffness",
        "tof_x / tof_y / tof_z (relative to center_torso_link)",
        "num_envs",
        "fps alone"
      ],
      "explain_en": "Accessories attach to center_torso_link; XYZ is relative offset, size/mass change shape and load."
    }
  ],
